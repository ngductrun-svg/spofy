# Node.js 24.15+; only public VITE_* values are included in the browser build.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data

# Server-only. Set in Netlify > Environment variables, Functions scope.
# Production APP_ORIGIN must be the exact public HTTPS origin.
# Get RESEND_API_KEY from your Resend account; MAIL_FROM must use a verified sender.
RESEND_API_KEY=
MAIL_FROM=
# local-blocklist works offline; hibp checks the HIBP range API and fails closed
# if that service is unavailable. Never expose these through VITE_* variables.
PASSWORD_BREACH_CHECK=local-blocklist
# Deploy Previews disable mail by default. Only an isolated preview database with
# MAIL_MODE=test and your own MAIL_TEST_RECIPIENT enables test mail; every message
# is redirected to that one mailbox, never to a registered production address.
MAIL_MODE=
MAIL_TEST_RECIPIENT=
# Preview API is disabled until the owner confirms an isolated test database.
# Set true only in the preview context after verifying the actual connection.
PREVIEW_DATA_ISOLATED=false

# Existing archive media; no account credential or private key.
VITE_ARCHIVE_ASSET_BASE=/archive/
VITE_ARCHIVE_CATALOG_URL=/archive-data.json

# Public canonical origin; never point this to a preview URL.
SITE_ORIGIN=https://spofysofia.netlify.app
# Preview builds require owner confirmation of an isolated, anonymized test DB.
# PREVIEW_DATA_ISOLATED=true
