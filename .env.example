# Node.js 24.15+; only public VITE_* values are included in the browser build.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data

# Existing archive media; no account credential or private key.
VITE_ARCHIVE_ASSET_BASE=https://spofy-archive.ngductrun.chatgpt.site/archive/
VITE_ARCHIVE_CATALOG_URL=/archive-data.json
